# Separate least-privilege bucket credentials; do not reuse runtime.env.
BACKUP_DATABASE_URL=postgresql://comiku_backup:replace-with-backup-reader-password@postgres:5432/comiku
BUSINESS_R2_BUCKET=
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
BACKUP_R2_BUCKET=
BACKUP_ENCRYPTION_KEY_FILE=/run/secrets/backup_encryption_key
# Keep false until the owner decides the policy and tests a restore.
BACKUP_POLICY_CONFIRMED=false
BACKUP_INTERVAL_HOURS=
BACKUP_RETENTION_DAYS=
BACKUP_RPO_HOURS=
BACKUP_RTO_MINUTES=
# Only used by the explicitly requested, empty-database restore drill.
RESTORE_DATABASE_URL=postgresql://comiku:replace-with-restore-password@postgres-restore:5432/comiku_restore_test
BACKUP_OBJECT_KEY=
