# Copy to deploy/.secrets/runtime.env; owned by uid 1000 and mode 0400 on Linux.
# API/worker/tools share this file. DATABASE_URL password must match postgres-password.
DATABASE_URL=postgresql://comiku:replace-with-random-password@postgres:5432/comiku
OBJECT_STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
SOURCE_SCHEDULE_ENABLED=false
SOURCE_SCHEDULE_MINUTES=60
SOURCE_OVERLAP_MINUTES=10
SOURCE_FAILURE_THRESHOLD=3
SOURCE_COOLDOWN_MINUTES=360
TYPESET_BATCH_MAX_MIB=512
TYPESET_BATCH_MAX_WORKS=20
X_BEARER_TOKEN=
X_OFFICIAL_DAILY_BUDGET=0
X_OFFICIAL_MONTHLY_BUDGET=0
X_WEB_BEARER_TOKEN=
X_WEB_AUTH_TOKEN=
X_WEB_CSRF_TOKEN=
X_WEB_USER_MEDIA_QUERY_ID=
X_WEB_USER_BY_SCREEN_NAME_QUERY_ID=
X_WEB_FEATURES_JSON={}
