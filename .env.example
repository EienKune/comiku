# Local API
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
# Leave empty for the Vite /api proxy. Cloudflare Pages sets the API origin.
VITE_API_BASE_URL=
HOST=127.0.0.1
PORT=3000
# Default: ignore client-supplied forwarding headers. Production trusts only Caddy.
TRUSTED_PROXY_CIDRS=

# Local PostgreSQL. Replace these values outside local development.
POSTGRES_DB=comiku
POSTGRES_USER=comiku
POSTGRES_PASSWORD=comiku_dev
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433
DATABASE_URL=postgresql://comiku:comiku_dev@127.0.0.1:5432/comiku

# Opt-in integration tests; use a separate disposable database ending in _test.
TEST_DATABASE_URL=postgresql://comiku:comiku_dev@127.0.0.1:5433/comiku_test

# Development defaults to repository-local storage. Production requires R2.
OBJECT_STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=.comiku-data/objects

# Optional when OBJECT_STORAGE_DRIVER=local; required for driver=r2/production.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional namespace within a shared bucket, for example source-test/.
R2_KEY_PREFIX=

SOURCE_OVERLAP_MINUTES=10
SOURCE_FAILURE_THRESHOLD=3
SOURCE_COOLDOWN_MINUTES=360

# Typeset bulk uploads: safety caps for the entire batch, including extracted images.
TYPESET_BATCH_MAX_MIB=512
TYPESET_BATCH_MAX_WORKS=20

# Worker only; real automatic source fetch is disabled in development.
SOURCE_SCHEDULE_ENABLED=false
SOURCE_SCHEDULE_MINUTES=60

# Optional adapters; credentials/config files stay outside the checkout.
# gallery-runtime Docker target provides /opt/gallery-dl/bin/python.
# Configure Python and at least one private platform config together.
# GALLERY_DL_PYTHON=/absolute/path/to/python
# GALLERY_DL_X_CONFIG=/absolute/private/x.json
# GALLERY_DL_PIXIV_CONFIG=/absolute/private/pixiv.json

# See docs/adapters/image-analysis.md. No model is loaded by default.
IMAGE_ANALYSIS_ADAPTER=disabled
# IMAGE_ANALYSIS_MODULE=/absolute/private-adapters/custom/adapter.mjs
# IMAGE_ANALYSIS_CONFIG_FILE=/absolute/private-config/ba-pixai.json
# Optional resident BA service variables; inject only into the model process.
# PIXAI_MODEL_DIR=/absolute/private-models/pixai/model
# PIXAI_CHECKPOINT=/absolute/private-models/pixai/checkpoint.pt
# PIXAI_HEAD_FILE=/absolute/private-models/pixai/head.json
# PIXAI_INTRA_OP_THREADS=2
# PIXAI_SERVICE_TOKEN=your-private-service-token
