model WorkReviewCase {
  contentRevision          WorkReviewRevision?
  purpose ReviewPurpose @default(production_decision)
  baseline Json @default("{}")
  discardedWork Work? @relation("DiscardedReview")
  restoredAt DateTime? @map("restored_at") @db.Timestamptz(3)
  id                       String            @id @default(uuid()) @db.Uuid
  workId                   String            @map("work_id") @db.Uuid
  work                     Work              @relation(fields: [workId], references: [id], onDelete: Restrict)
  openedFromWorkflowStatus WorkflowStatus    @map("opened_from_workflow_status")
  openedTypesetVersionId   String?           @map("opened_typeset_version_id") @db.Uuid
  openedTypesetVersion     TypesetImageVersion? @relation("ReviewCaseOpenedTypesetVersion", fields: [openedTypesetVersionId], references: [id], onDelete: Restrict)
  reason                   String            @db.Text
  status                   ReviewCaseStatus  @default(open)
  openedById               String            @map("opened_by") @db.Uuid
  openedBy                 User              @relation("ReviewCaseOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  resolvedById             String?           @map("resolved_by") @db.Uuid
  resolvedBy               User?             @relation("ReviewCaseResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)
  resolution               ReviewResolution?
  targetWorkflowStatus     WorkflowStatus?   @map("target_workflow_status")
  resolutionNote           String?           @map("resolution_note") @db.Text
  revision                 Int               @default(0)
  createdAt                DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt               DateTime?         @map("resolved_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([workId, createdAt])
  @@index([openedTypesetVersionId])
  @@index([openedById, createdAt])
  @@map("work_review_cases")
}

model TypesetUploadSession {
