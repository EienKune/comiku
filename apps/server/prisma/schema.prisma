generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  authorCreationRequests AuthorCreationRequest[]
  candidateReviewSessions CandidateReviewSession[]
  reviewRevisionParticipations        ReviewRevisionParticipant[]
  canSkipProofreading                 Boolean                           @default(false) @map("can_skip_proofreading")
  id                                  String                        @id @default(uuid()) @db.Uuid
  username                            String                        @unique @db.VarChar(64)
  passwordHash                        String                        @map("password_hash") @db.Text
  displayName                         String                        @map("display_name") @db.VarChar(100)
  qqNumber                            String?                       @unique @map("qq_number") @db.VarChar(20)
  avatarObjectKey                     String?                       @map("avatar_object_key") @db.Text
  avatarFileObjectId                  String?                       @map("avatar_file_object_id") @db.Uuid
  avatarFileObject                    FileObject?                   @relation("UserAvatar", fields: [avatarFileObjectId], references: [id], onDelete: Restrict)
  avatarUploadSessions                UserAvatarUploadSession[]
  isActive                            Boolean                       @default(true) @map("is_active")
  mustChangePassword                  Boolean                       @default(true) @map("must_change_password")
  revision                            Int                           @default(0)
  roles                               UserRole[]
  languageCapabilities                UserLanguageCapability[]
  sessions                            AuthSession[]
  translationEditorPresences          TranslationEditorPresence[]
  filesCreated                        FileObject[]                  @relation("FileCreatedBy")
  authorEvidenceUploaded             AuthorAuthorizationEvidence[] @relation("AuthorEvidenceUploadedBy")
  authorEvidenceDeleted              AuthorAuthorizationEvidence[] @relation("AuthorEvidenceDeletedBy")
  fetchRunsRequested                  SourceFetchRun[]              @relation("FetchRunRequestedBy")
  candidatesReviewed                  CandidatePost[]               @relation("CandidateReviewedBy")
  typesetUploadSessions               TypesetUploadSession[]
  candidateUploadSessions             CandidateUploadSession[]      @relation("CandidateUploadSessionCreatedBy")
  worksImported                       Work[]                        @relation("WorkImportedBy")
  candidateActions                    CandidateActionLog[]          @relation("CandidateActionActor")
  workParticipations                  WorkStageParticipant[]
  workCreditAliases                   WorkCreditAlias[]
  workEvents                          WorkEvent[]                   @relation("WorkEventActor")
  reviewCasesOpened                   WorkReviewCase[]              @relation("ReviewCaseOpenedBy")
  reviewCasesResolved                 WorkReviewCase[]              @relation("ReviewCaseResolvedBy")
  translationEntriesCreated           TranslationEntry[]            @relation("TranslationEntryCreatedBy")
  translationEntriesUpdated           TranslationEntry[]            @relation("TranslationEntryUpdatedBy")
  translationVersionsCreated          TranslationVersion[]          @relation("TranslationVersionCreatedBy")
  labelPlusFilesCreated               LabelPlusFile[]               @relation("LabelPlusFileCreatedBy")
  typesetPackagesCreated              TypesetHandoffPackage[]       @relation("TypesetPackageCreatedBy")
  typesetVersionsUploaded             TypesetImageVersion[]         @relation("TypesetVersionUploadedBy")
  typesetVersionsDeleted              TypesetImageVersion[]         @relation("TypesetVersionDeletedBy")
  publishTemplatesUpdated             PublishTemplate[]             @relation("PublishTemplateUpdatedBy")
  publishRecords                      PublishRecord[]                @relation("PublishRecordPublishedBy")
  workStageAssignmentsCreated         WorkStageAssignment[]         @relation("WorkStageAssignmentCreatedBy")
  stageContributionSubmissionsCreated StageContributionSubmission[] @relation("StageContributionSubmissionCreatedBy")
  createdAt                           DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                           DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("users")
}

enum Role {
  admin
  source
  translator
  proofreader
  typesetter
  operator
  reviewer
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  role      Role
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([userId, role])
  @@map("user_roles")
}

enum LanguageCapability {
  ja
  ko
}

model UserLanguageCapability {
  userId    String             @map("user_id") @db.Uuid
  language  LanguageCapability
  user      User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([userId, language])
  @@map("user_language_capabilities")
}

model AuthSession {
  id                         String                      @id @default(uuid()) @db.Uuid
  userId                     String                      @map("user_id") @db.Uuid
  tokenHash                  String                      @unique @map("token_hash") @db.Char(64)
  user                       User                        @relation(fields: [userId], references: [id], onDelete: Restrict)
  translationEditorPresences TranslationEditorPresence[]
  createdAt                  DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt                 DateTime                    @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt                  DateTime                    @map("expires_at") @db.Timestamptz(3)
  revokedAt                  DateTime?                   @map("revoked_at") @db.Timestamptz(3)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AccountAudit {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  targetId  String?  @map("target_id") @db.Uuid
  action    String   @db.VarChar(64)
  detail    Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("account_audit")
}

enum AuthorizationStatus {
  pending
  authorized
  expired
  revoked
}

enum FirstSyncMode {
  none
  last_24_hours
  last_7_days
}

enum FileLifecycleStatus {
  active
  pending_deletion
  deleted
}

model FileObject {
  id                   String                        @id @default(uuid()) @db.Uuid
  objectKey            String                        @unique @map("object_key") @db.Text
  bucketScope          String                        @map("bucket_scope") @db.VarChar(32)
  kind                 String                        @db.VarChar(64)
  contentType          String                        @map("content_type") @db.VarChar(255)
  size                 BigInt
  checksum             String                        @db.Char(64)
  lifecycleStatus      FileLifecycleStatus           @default(active) @map("lifecycle_status")
  createdById          String?                       @map("created_by") @db.Uuid
  createdBy            User?                         @relation("FileCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  downloadPreparations DownloadPreparation[]
  imageDerivatives     ImageDerivative[]             @relation("DerivativeSource")
  derivativeOutputs    ImageDerivative[]             @relation("DerivativeOutput")
  authorAvatars        Author[]                      @relation("AuthorAvatar")
  accountAvatars       AuthorExternalAccount[]       @relation("ExternalAccountAvatar")
  userAvatars          User[]                        @relation("UserAvatar")
  authorEvidence       AuthorAuthorizationEvidence[]
  discoveryMedia       SourceDiscoveryMedia[]
  candidateMedia       CandidateMedia[]
  workImages           WorkImage[]
  labelPlusFiles       LabelPlusFile[]
  typesetPackages      TypesetHandoffPackage[]
  typesetUploadImages  TypesetUploadImage[]
  typesetImages        TypesetImageVersionImage[]
  createdAt            DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt            DateTime?                     @map("deleted_at") @db.Timestamptz(3)

  @@index([bucketScope, kind, lifecycleStatus])
  @@index([createdById])
  @@map("file_objects")
}

model Author {
  notes                  String? @db.Text
  creationRequests AuthorCreationRequest[]
  id                  String                  @id @default(uuid()) @db.Uuid
  displayName         String                  @map("display_name") @db.VarChar(100)
  avatarFileObjectId  String?                 @map("avatar_file_object_id") @db.Uuid
  avatarFileObject    FileObject?             @relation("AuthorAvatar", fields: [avatarFileObjectId], references: [id], onDelete: Restrict)
  authorizationStatus AuthorizationStatus     @default(pending) @map("authorization_status")
  sourceLanguage      SourceLanguage          @default(ja) @map("source_language")
  revision            Int                     @default(0)
  externalAccounts    AuthorExternalAccount[]
  authorizationEvidence AuthorAuthorizationEvidence[]
  tags                AuthorTag[]
  candidates          CandidatePost[]
  candidateUploadSessions CandidateUploadSession[]
  works               Work[]
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?               @map("deleted_at") @db.Timestamptz(3)

  @@index([authorizationStatus, deletedAt])
  @@map("authors")
}

model AuthorCreationRequest {
  id             String   @id @default(uuid()) @db.Uuid
  actorId        String   @map("actor_id") @db.Uuid
  actor          User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  idempotencyKey String   @map("idempotency_key") @db.Uuid
  payloadHash    String   @map("payload_hash") @db.Char(64)
  authorId       String?  @map("author_id") @db.Uuid
  author         Author?  @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([actorId, idempotencyKey])
  @@index([authorId])
  @@map("author_creation_requests")
}

model AuthorAuthorizationEvidence {
  id           String      @id @default(uuid()) @db.Uuid
  authorId     String      @map("author_id") @db.Uuid
  author       Author      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  fileObjectId String      @map("file_object_id") @db.Uuid
  fileObject   FileObject  @relation(fields: [fileObjectId], references: [id], onDelete: Restrict)
  orderIndex   Int         @map("order_index")
  uploadedById String      @map("uploaded_by") @db.Uuid
  uploadedBy   User        @relation("AuthorEvidenceUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  deletedById  String?     @map("deleted_by") @db.Uuid
  deletedBy    User?       @relation("AuthorEvidenceDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt    DateTime?   @map("deleted_at") @db.Timestamptz(3)

  @@index([authorId, orderIndex])
  @@index([authorId, deletedAt])
  @@index([fileObjectId])
  @@map("author_authorization_evidence")
}

model AuthorExternalAccount {
  notes                  String? @db.Text
  id                  String               @id @default(uuid()) @db.Uuid
  authorId            String               @map("author_id") @db.Uuid
  author              Author               @relation(fields: [authorId], references: [id], onDelete: Restrict)
  platform            String               @db.VarChar(32)
  externalUserId      String               @map("external_user_id") @db.VarChar(255)
  handle              String?              @db.VarChar(255)
  profileUrl          String?              @map("profile_url") @db.VarChar(2048)
  displayNameSnapshot String?              @map("display_name_snapshot") @db.VarChar(255)
  avatarFileObjectId  String?              @map("avatar_file_object_id") @db.Uuid
  avatarFileObject    FileObject?          @relation("ExternalAccountAvatar", fields: [avatarFileObjectId], references: [id], onDelete: Restrict)
  fetchEnabled        Boolean              @default(true) @map("fetch_enabled")
  firstSyncMode       FirstSyncMode        @default(none) @map("first_sync_mode")
  metadataJson        Json                 @default("{}") @map("metadata_json")
  revision            Int                  @default(0)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?            @map("deleted_at") @db.Timestamptz(3)
  fetchRunItems       SourceFetchRunItem[]
  fetchAccountTasks  SourceFetchAccountTask[]
  discoveries         SourceDiscoveryPost[]
  scanState           SourceAccountScanState?
  adapterStates       SourceAdapterState[]
  sourceObservations  CandidateSourceObservation[]
  candidates          CandidatePost[]

  @@unique([platform, externalUserId])
  // Partial active (author_id, platform) uniqueness is enforced in the forward SQL migration.
  @@index([authorId, deletedAt])
  @@index([platform, fetchEnabled, deletedAt])
  @@map("author_external_accounts")
}

model Tag {
  id             String      @id @default(uuid()) @db.Uuid
  name           String      @db.VarChar(64)
  normalizedName String      @unique @map("normalized_name") @db.VarChar(64)
  revision       Int         @default(0)
  authors        AuthorTag[]
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("tags")
}

model AuthorTag {
  authorId  String   @map("author_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  author    Author   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([authorId, tagId])
  @@index([tagId])
  @@map("author_tags")
}

enum SourceFetchTrigger {
  manual
  scheduled
}

enum SourceFetchRunStatus {
  queued
  running
  succeeded
  partial_failed
  failed
}

enum SourceFetchItemStatus {
  running
  succeeded
  failed
  skipped
}

enum SourceAdapterHealth {
  idle
  healthy
  degraded
  cooling_down
  unavailable
  disabled
}

enum CandidateTagGroupKind {
  valid
  gray
  blocked
}

enum CandidateStatus {
  pending
  imported
  discarded
}

enum CandidateUploadSessionStatus {
  pending
  finalizing
  completed
  expired
}

enum CandidateUploadItemStatus {
  pending
  created
  failed
}

model CandidateUploadSession {
  id          String                       @id @default(uuid()) @db.Uuid
  actorId     String                       @map("actor_id") @db.Uuid
  actor       User                         @relation("CandidateUploadSessionCreatedBy", fields: [actorId], references: [id], onDelete: Restrict)
  authorId    String                       @map("author_id") @db.Uuid
  author      Author                       @relation(fields: [authorId], references: [id], onDelete: Restrict)
  text        String?                      @db.Text
  sourceUrl   String?                      @map("source_url") @db.VarChar(2048)
  status      CandidateUploadSessionStatus @default(pending)
  items       CandidateUploadItem[]
  expiresAt   DateTime                     @map("expires_at") @db.Timestamptz(3)
  completedAt DateTime?                    @map("completed_at") @db.Timestamptz(3)
  createdAt   DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([actorId, createdAt])
  @@index([status, expiresAt])
  @@map("candidate_upload_sessions")
}

model CandidateUploadItem {
  id              String                    @id @default(uuid()) @db.Uuid
  sessionId       String                    @map("session_id") @db.Uuid
  session         CandidateUploadSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sourceName      String                    @map("source_name") @db.VarChar(255)
  objectKey       String                    @unique @map("object_key") @db.Text
  contentType     String                    @map("content_type") @db.VarChar(255)
  size            BigInt
  checksum        String                    @db.Char(64)
  status          CandidateUploadItemStatus @default(pending)
  resultMessage   String?                   @map("result_message") @db.VarChar(500)
  warnings        Json?
  candidatePostId String?                   @unique @map("candidate_post_id") @db.Uuid
  candidatePost   CandidatePost?            @relation(fields: [candidatePostId], references: [id], onDelete: Restrict)
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([sessionId, status])
  @@map("candidate_upload_items")
}

enum CandidateActionType {
  import
  discard
  restore
}

enum ReferencedPostType {
  reply
  quote
}

enum WorkflowStatus {
  pending_translate
  translating
  pending_proofread
  proofreading
  pending_typeset
  typesetting
  pending_publish
  published
  archived
}

enum ReviewStatus {
  normal
  needs_review
  blocked
}

enum WorkStage {
  translate
  proofread
  typeset
  publish
}

enum WorkParticipationMode {
  owner
  collaborator
}

enum SourceLanguage {
  ja
  ko
  en
}

enum WorkCollaborationMode {
  single
  multi
}

enum TranslationPresenceMode {
  view
  edit
}

enum MarkerPositionType {
  inside
  outside
}

enum TranslationVersionKind {
  translate_submission
  proofread_submission
  revision
  labelplus_import
}

enum LabelPlusFileDirection {
  import
  export
}

enum TypesetHandoffPackageKind {
  source_images
  unified_handoff
}

enum WorkEventAction {
  review_withdrawn
  review_revision_joined
  review_revision_left
  review_revision_pages_updated
  review_revision_contribution_completed
  review_revision_completed
  typeset_version_reviewed
  proofreading_skipped
  imported
  metadata_updated
  collaboration_mode_updated
  stage_joined
  stage_assigned
  stage_credit_updated
  stage_assignment_updated
  stage_contribution_completed
  stage_left
  stage_started
  stage_submitted
  stage_submission_cancelled
  translation_revision_submitted
  translation_imported
  typeset_handoff_started
  typeset_version_uploaded
  typeset_version_selected
  typeset_version_deleted
  typeset_version_restored
  publish_confirmed
  review_opened
  review_resumed
  review_revised
  review_kept_pending
  review_blocked
  archived
  restored
}

enum ReviewCaseStatus {
  open
  resolved
}

enum ReviewRevisionStatus {
  active
  completed
}

enum ReviewPurpose {
  production_decision
  content_revision
}

enum ReviewResolution {
  withdrawn
  continue_production
  discard
  restore_production
  approve_revision
  resume
  revise
  keep_pending
  block
}

model SourceFetchRun {
  id            String               @id @default(uuid()) @db.Uuid
  trigger       SourceFetchTrigger
  status        SourceFetchRunStatus @default(running)
  requestedById String?              @map("requested_by") @db.Uuid
  requestedBy   User?                @relation("FetchRunRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  items         SourceFetchRunItem[]
  accountTasks  SourceFetchAccountTask[]
  startedAt     DateTime             @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt   DateTime?            @map("completed_at") @db.Timestamptz(3)

  @@index([startedAt])
  @@index([trigger, startedAt])
  @@index([status, startedAt])
  @@map("source_fetch_runs")
}

model SourceFetchRunItem {
  id                 String                @id @default(uuid()) @db.Uuid
  runId              String                @map("run_id") @db.Uuid
  run                SourceFetchRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  externalAccountId  String                @map("external_account_id") @db.Uuid
  externalAccount    AuthorExternalAccount @relation(fields: [externalAccountId], references: [id], onDelete: Restrict)
  adapterStateId     String                @map("adapter_state_id") @db.Uuid
  adapterState       SourceAdapterState    @relation(fields: [adapterStateId], references: [id], onDelete: Restrict)
  adapterKey         String                @map("adapter_key") @db.VarChar(64)
  status             SourceFetchItemStatus @default(running)
  cursorBefore       Json                  @map("cursor_before")
  cursorAfter        Json?                 @map("cursor_after")
  pagesFetched       Int                   @default(0) @map("pages_fetched")
  itemsSeen          Int                   @default(0) @map("items_seen")
  candidatesCreated  Int                   @default(0) @map("candidates_created")
  candidatesExisting Int                   @default(0) @map("candidates_existing")
  mediaStored        Int                   @default(0) @map("media_stored")
  apiRequests        Int                   @default(0) @map("api_requests")
  errorCode          String?               @map("error_code") @db.VarChar(64)
  errorMessage       String?               @map("error_message") @db.VarChar(500)
  startedAt          DateTime              @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt        DateTime?             @map("completed_at") @db.Timestamptz(3)

  @@unique([runId, externalAccountId, adapterKey], map: "source_fetch_run_items_run_id_external_account_id_adapter_key_k")
  @@index([externalAccountId, startedAt])
  @@index([adapterStateId, startedAt])
  @@map("source_fetch_run_items")
}

model SourceAccountScanState {
  accountId String @id @map("account_id") @db.Uuid
  account AuthorExternalAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  discoveredThroughAt DateTime? @map("discovered_through_at") @db.Timestamptz(3)
  windowJson Json @default("{}") @map("window_json")
  leaseOwnerJobId String? @map("lease_owner_job_id") @db.Uuid
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(3)
  epoch Int @default(0)
  revision Int @default(0)

  @@index([leaseUntil])
  @@map("source_account_scan_states")
}

model SourceAdapterState {
  id                    String                  @id @default(uuid()) @db.Uuid
  externalAccountId     String                  @map("external_account_id") @db.Uuid
  externalAccount       AuthorExternalAccount   @relation(fields: [externalAccountId], references: [id], onDelete: Cascade)
  adapterKey            String                  @map("adapter_key") @db.VarChar(64)
  enabled               Boolean                 @default(true)
  health                SourceAdapterHealth     @default(idle)
  cursorJson            Json                    @default("{}") @map("cursor_json")
  discoveryCheckpointJson Json                         @default("{}") @map("discovery_checkpoint_json")
  completedThroughAt      DateTime?                    @map("completed_through_at") @db.Timestamptz(3)
  highWaterPublishedAt  DateTime?               @map("high_water_published_at") @db.Timestamptz(3)
  highWaterExternalId   String?                 @map("high_water_external_id") @db.VarChar(255)
  lastAttemptAt         DateTime?               @map("last_attempt_at") @db.Timestamptz(3)
  lastSuccessAt         DateTime?               @map("last_success_at") @db.Timestamptz(3)
  consecutiveFailures   Int                     @default(0) @map("consecutive_failures")
  nextAttemptAt         DateTime?               @map("next_attempt_at") @db.Timestamptz(3)
  lastErrorCode         String?                 @map("last_error_code") @db.VarChar(64)
  lastErrorMessage      String?                 @map("last_error_message") @db.VarChar(500)
  fetchLeaseId          String?                 @map("fetch_lease_id") @db.Uuid
  fetchLeaseUntil       DateTime?               @map("fetch_lease_until") @db.Timestamptz(3)
  revision              Int                     @default(0)
  runItems              SourceFetchRunItem[]
  observations          CandidateSourceObservation[]
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([externalAccountId, adapterKey])
  @@index([adapterKey, enabled, health, nextAttemptAt], map: "source_adapter_states_adapter_key_enabled_health_next_attempt_a")
  @@index([fetchLeaseUntil])
  @@map("source_adapter_states")
}

model SourceAdapterBudgetUsage {
  adapterKey String   @map("adapter_key") @db.VarChar(64)
  periodKey  String   @map("period_key") @db.VarChar(16)
  used       Int      @default(0)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([adapterKey, periodKey])
  @@map("source_adapter_budget_usage")
}

model CandidatePost {
  reviewSessionEntries CandidateReviewSessionEntry[]
  id                      String                 @id @default(uuid()) @db.Uuid
  authorId                String                 @map("author_id") @db.Uuid
  author                  Author                 @relation(fields: [authorId], references: [id], onDelete: Restrict)
  authorExternalAccountId String?                @map("author_external_account_id") @db.Uuid
  authorExternalAccount   AuthorExternalAccount? @relation(fields: [authorExternalAccountId], references: [id], onDelete: Restrict)
  platform                String                 @db.VarChar(32)
  externalPostId          String                 @map("external_post_id") @db.VarChar(255)
  externalPostUrl         String?                @map("external_post_url") @db.VarChar(2048)
  text                    String?                @db.Text
  referencedPostType      ReferencedPostType?    @map("referenced_post_type")
  referencedPostId        String?                @map("referenced_post_id") @db.VarChar(255)
  postedAt                DateTime               @map("posted_at") @db.Timestamptz(3)
  rawJson                 Json                   @map("raw_json")
  analysisScore           Float?                 @map("analysis_score")
  analysisState           String                 @default("unprocessed") @map("analysis_state") @db.VarChar(20)
  analysisSummaryVersion  Int                    @default(0) @map("analysis_summary_version")
  analysisModelKey        String?                @map("analysis_model_key") @db.VarChar(64)
  analysisPredictions     Json?                  @map("analysis_predictions")
  status                  CandidateStatus        @default(pending)
