{
  "name": "@comiku/server",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm db:generate && tsx watch src/main.ts",
    "build": "pnpm db:generate && tsc -p tsconfig.build.json && node scripts/copy-adapter-assets.mjs",
    "typecheck": "pnpm db:generate && tsc --noEmit --pretty false",
    "start": "node dist/main.js",
    "test": "pnpm db:generate && tsx --test test/*.test.ts",
    "test:integration": "pnpm db:generate && tsx --test --test-concurrency=1 test/integration/*.test.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "openapi:export": "pnpm db:generate && tsx scripts/export-openapi.ts",
    "openapi:check": "pnpm db:generate && tsx scripts/export-openapi.ts --check",
    "admin:init": "pnpm db:generate && tsx scripts/admin.ts init",
    "admin:recover": "pnpm db:generate && tsx scripts/admin.ts recover",
    "demo:init": "pnpm db:generate && tsx scripts/demo.ts",
    "dev:worker": "pnpm db:generate && tsx watch src/worker.ts",
    "start:worker": "node dist/worker.js",
    "images:backfill": "pnpm db:generate && tsx scripts/backfill-thumbnails.ts",
    "build:ops": "tsc -p tsconfig.ops.json",
    "ops:status": "pnpm db:generate && tsx src/ops/status.ts",
    "backup": "tsx scripts/backup.ts",
    "deploy:check": "tsx scripts/check-production.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.888.0",
    "@aws-sdk/s3-request-presigner": "3.888.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "dotenv": "17.4.2",
    "fflate": "0.8.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.1",
    "@types/express": "5.0.6",
    "@types/node": "^24.0.0",
    "prisma": "7.10.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "license": "MIT"
}
